# Configuração pessoal do comando "mr" (não compartilhe este arquivo).

# Personal Access Token do GitLab (escopo "api")
# Gere em: https://gitlab.sebrae.com.br/-/user_settings/personal_access_tokens
GITLAB_TOKEN=seu_token_aqui

# Branch de destino quando nenhuma for informada (vazio = branch padrão do projeto no GitLab)
GITLAB_TARGET_BRANCH=

# Assignee e reviewer padrão (username do GitLab; vários separados por vírgula)
# Vazio em GITLAB_ASSIGNEE = você mesmo. Na hora, use -a / -r para trocar.
GITLAB_ASSIGNEE=
GITLAB_REVIEWER=

# Certificado raiz (ex.: Zscaler) caso dê erro de SSL
GITLAB_CA_BUNDLE=
GITLAB_SSL_VERIFY=true

# Usados só quando o repositório não tem remoto "origin"
# GITLAB_URL=https://gitlab.sebrae.com.br
# GITLAB_PROJECT=df/cerebro
